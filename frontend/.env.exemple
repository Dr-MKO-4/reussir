# API Configuration
VITE_API_URL=http://localhost:5001
VITE_FLASK_URL=http://localhost:5000

# AWS Cognito Configuration
VITE_AWS_REGION=us-east-1
VITE_AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_AWS_USER_POOL_CLIENT_ID=your-client-id
VITE_AWS_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OAuth Configuration (optionnel)
VITE_AWS_OAUTH_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
VITE_AWS_OAUTH_REDIRECT_SIGNIN=http://localhost:3000/
VITE_AWS_OAUTH_REDIRECT_SIGNOUT=http://localhost:3000/
VITE_AWS_OAUTH_SCOPE=phone email openid profile aws.cognito.signin.user.admin

# App Configuration
VITE_APP_NAME="Educational AI Platform"
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_DARK_MODE=true

# Analytics (optionnel)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=